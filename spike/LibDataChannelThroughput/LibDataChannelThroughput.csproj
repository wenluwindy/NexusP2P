<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LibDataChannelThroughput</RootNamespace>
    <!-- spike 是一次性代码，不套用主解决方案那套严格分析 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DataChannelDotnet" Version="1.3.1" />
  </ItemGroup>

  <!--
    刻意复用 SipSorcery spike 的同一份浏览器页面。
    两个 spike 的浏览器侧代码必须完全一致，否则测出来的数字不可比 ——
    而「能不能比」正是 bake-off 的全部意义。
  -->
  <ItemGroup>
    <Content Include="..\SipSorceryThroughput\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
