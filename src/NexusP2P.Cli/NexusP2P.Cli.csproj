<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NexusP2P.Agent\NexusP2P.Agent.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- 产物叫 nexusp2p 而不是 NexusP2P.Cli：这是要在两台机器上手敲的命令 -->
    <AssemblyName>nexusp2p</AssemblyName>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
