<Window x:Class="NexusP2P.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexusP2P" Height="700" Width="620"
        MinHeight="560" MinWidth="520"
        Background="{StaticResource PageBg}"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Closing="OnClosing">

    <DockPanel>
        <!-- 页头：与网页端 hero 一致 —— 浅色底、居中标题、强调色圆角标 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PageBg}" Padding="24,26,24,8">
            <StackPanel HorizontalAlignment="Center">
                <Border Background="{StaticResource Primary}" CornerRadius="12"
                        Width="44" Height="44" HorizontalAlignment="Center">
                    <TextBlock Text="⇄" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="NexusP2P" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="点对点直连传输，内容端到端加密" FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 配置问题条：缺信令地址时显示，而不是等用户点了才报错。
             白卡片 + 左侧橙色竖条，不用大面积琥珀底 —— 强调色保持单一 -->
        <Border x:Name="ConfigWarning" DockPanel.Dock="Top"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="8" Margin="20,0,20,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" Margin="1"
                        Background="{StaticResource Warning}" CornerRadius="2" />
                <TextBlock x:Name="ConfigWarningText" Grid.Column="1"
                           Margin="12,10" FontSize="12"
                           Foreground="{StaticResource TextPrimary}" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs">
            <TabItem Header="发送">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="DropZone" BorderBrush="{StaticResource BorderStrong}"
                                BorderThickness="1" CornerRadius="12" Padding="24,36"
                                Background="{StaticResource SurfaceAlt}"
                                AllowDrop="True" Drop="OnDrop"
                                DragEnter="OnDragEnter" DragOver="OnDragEnter" DragLeave="OnDragLeave">
                            <StackPanel>
                                <TextBlock Text="把文件或文件夹拖到这里" FontSize="15"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,16,0,0">
                                    <Button Content="选择文件" Style="{StaticResource PrimaryButton}"
                                            Click="OnPickFile" Margin="0,0,10,0" />
                                    <Button Content="选择文件夹" Style="{StaticResource SecondaryButton}"
                                            Click="OnPickFolder" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SelectedPath" Margin="0,14,0,0" FontSize="13"
                                   Visibility="Collapsed" />

                        <!-- 接收人数（V2）：默认 1 人 = 一对一，与 V1 完全相同 -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="允许接收人数" VerticalAlignment="Center"
                                       Style="{StaticResource Caption}" Margin="0,0,10,0" />
                            <TextBox x:Name="MaxPeersInput" Width="64" Text="1"
                                     HorizontalContentAlignment="Center"
                                     PreviewTextInput="OnMaxPeersTextInput" />
                            <TextBlock Text="1 人即一对一；多人同时接收共享本机上行带宽（上限 8 人）"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Style="{StaticResource Caption}" />
                        </StackPanel>

                        <Button x:Name="SendButton" Content="生成文件码并等待对方"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,16,0,0" Click="OnStartSend"
                                IsEnabled="False" />

                        <!-- 文件码区：建房成功后立刻显示，不等对方进来 -->
                        <Border x:Name="CodePanel" Background="{StaticResource SurfaceAlt}"
                                CornerRadius="12" Padding="18" Margin="0,18,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="文件码" Style="{StaticResource Caption}" />
                                <TextBox x:Name="CodeText" Style="{StaticResource CodeDisplay}"
                                         Margin="0,6,0,10" />

                                <TextBlock Text="分享链接（含密钥，推荐直接发这个）"
                                           Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                <TextBox x:Name="ShareUrlText" IsReadOnly="True" Margin="0,6,0,8"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                                         Background="{StaticResource Surface}" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="复制文件码" Style="{StaticResource SecondaryButton}"
                                            Click="OnCopyCode" Margin="0,0,8,0" />
                                    <Button Content="复制分享链接" Style="{StaticResource SecondaryButton}"
                                            Click="OnCopyLink" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           Text="密钥在链接的 # 之后，按规范永远不会发送到服务器 —— 这就是服务器即使中继流量也无法解密的原因。" />
                            </StackPanel>
                        </Border>

                        <!-- 进度区 -->
                        <Border x:Name="SendProgressPanel" Background="{StaticResource SurfaceAlt}"
                                CornerRadius="12" Padding="18" Margin="0,18,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="SendStatus" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SendConnection" HorizontalAlignment="Right"
                                               Style="{StaticResource Caption}" />
                                </Grid>

                                <ProgressBar x:Name="SendBar" Style="{StaticResource TransferProgress}"
                                             Margin="0,10,0,8" Maximum="1" />

                                <Grid>
                                    <TextBlock x:Name="SendNumbers" Style="{StaticResource Caption}"
                                               FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock x:Name="SendEta" HorizontalAlignment="Right"
                                               Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" />
                                </Grid>

                                <Border Background="{StaticResource Surface}" CornerRadius="8"
                                        Padding="10,8" Margin="0,10,0,0" BorderThickness="3,0,0,0"
                                        BorderBrush="{StaticResource Primary}">
                                    <TextBlock x:Name="SendBottleneck" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Border>

                                <!-- 接收方列表（V2）：只在一对多时出现，一人接收时界面与 V1 一致 -->
                                <ItemsControl x:Name="ReceiverList" Margin="0,10,0,0"
                                              Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface}" CornerRadius="8"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock HorizontalAlignment="Right" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Text="{Binding Detail}" />
                                                    </Grid>
                                                    <ProgressBar Height="4" Margin="0,6,0,0" Maximum="1"
                                                                 Value="{Binding Fraction, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="SendCancelButton" Content="取消"
                                        Style="{StaticResource DangerButton}"
                                        Margin="0,12,0,0" Click="OnCancel" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="接收">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="分享链接或九位文件码" Style="{StaticResource Caption}" />
                        <TextBox x:Name="ReceiveInput" Margin="0,6,0,14"
                                 TextChanged="OnReceiveInputChanged" />

                        <TextBlock Text="密钥（粘贴完整分享链接时可留空）"
                                   Style="{StaticResource Caption}" />
                        <TextBox x:Name="ReceiveKey" Margin="0,6,0,14" FontFamily="{StaticResource MonoFont}"
                                 FontSize="12" />

                        <TextBlock Text="保存到" Style="{StaticResource Caption}" />
                        <Grid Margin="0,6,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReceiveFolder" IsReadOnly="True" FontSize="12" />
                            <Button Grid.Column="1" Content="更改…" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="OnPickFolderForReceive" />
                        </Grid>

                        <Button x:Name="ReceiveButton" Content="开始接收"
                                Style="{StaticResource PrimaryButton}" Click="OnStartReceive" />

                        <Border x:Name="ReceiveProgressPanel" Background="{StaticResource SurfaceAlt}"
                                CornerRadius="12" Padding="18" Margin="0,18,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="ReceiveStatus" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReceiveConnection" HorizontalAlignment="Right"
                                               Style="{StaticResource Caption}" />
                                </Grid>

                                <ProgressBar x:Name="ReceiveBar" Style="{StaticResource TransferProgress}"
                                             Margin="0,10,0,8" Maximum="1" />

                                <Grid>
                                    <TextBlock x:Name="ReceiveNumbers" Style="{StaticResource Caption}"
                                               FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock x:Name="ReceiveEta" HorizontalAlignment="Right"
                                               Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" />
                                </Grid>

                                <Border Background="{StaticResource Surface}" CornerRadius="8"
                                        Padding="10,8" Margin="0,10,0,0" BorderThickness="3,0,0,0"
                                        BorderBrush="{StaticResource Primary}">
                                    <TextBlock x:Name="ReceiveBottleneck" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Border>

                                <Button x:Name="ReceiveCancelButton" Content="取消"
                                        Style="{StaticResource DangerButton}"
                                        Margin="0,12,0,0" Click="OnCancel" />
                            </StackPanel>
                        </Border>

                        <!-- 收完之后列出落地的文件，并给一个「打开文件夹」 -->
                        <Border x:Name="LandedPanel" Background="{StaticResource SurfaceAlt}"
                                CornerRadius="12" Padding="18" Margin="0,14,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="LandedTitle" FontWeight="SemiBold" FontSize="13" />
                                <ItemsControl x:Name="LandedFiles" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="打开所在文件夹" Style="{StaticResource SecondaryButton}"
                                        Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Click="OnOpenReceiveFolder" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="信令服务器" FontWeight="SemiBold" FontSize="14"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="SignalingInput" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="形如 https://p2p.你的域名。信令服务器只负责把两端接上；它拿不到密钥，因此看不到文件内容和文件名。" />
                        <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnSaveSignaling" />

                        <Separator Margin="0,20,0,16" />

                        <TextBlock Text="接收" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <CheckBox x:Name="NotificationsCheck" Content="传输完成或失败时弹系统通知"
                                  Click="OnSettingsToggled" />
                        <CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘（传输继续进行）"
                                  Click="OnSettingsToggled" />
                        <TextBlock x:Name="TrayNote" Style="{StaticResource Caption}"
                                   Visibility="Collapsed" Margin="0,0,0,10" />

                        <!--
                            一个明确的退出入口。
                            勾了「最小化到托盘」之后，关窗只是隐藏 —— 而托盘图标
                            常常被折叠进「显示隐藏的图标」里，用户找不到就会觉得
                            「这软件关不掉」。放一个按钮在这里，不依赖托盘。
                        -->
                        <Button Content="退出程序" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnQuit" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="关闭窗口只是缩到托盘，传输不会中断。要完全退出用这个按钮，或托盘图标右键菜单里的「退出」。" />

                        <Separator Margin="0,20,0,16" />

                        <TextBlock Text="软件更新" FontWeight="SemiBold" FontSize="14"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateVersionText" FontSize="13" />
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Caption}"
                                           Margin="0,3,16,0"
                                           Text="从 GitHub Releases 获取正式版本。" />
                            </StackPanel>
                            <Button x:Name="UpdateButton" Grid.Column="1"
                                    Content="检查更新" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnCheckUpdate" />
                        </Grid>
                        <ProgressBar x:Name="UpdateProgressBar"
                                     Style="{StaticResource TransferProgress}"
                                     Margin="0,12,0,0" Maximum="1"
                                     Visibility="Collapsed" />

                        <Separator Margin="0,20,0,16" />

                        <TextBlock Text="关于" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="传输内容用 AES-256-GCM 加密，完整性由 SHA-256 Merkle 树逐分片校验。断线自动重连 3 次；进度按内容记录，关掉程序重开也能接着传。" />
                        <TextBlock x:Name="ConfigPathText" Style="{StaticResource Caption}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
