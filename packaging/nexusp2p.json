{
  // 信令服务器地址。改这一行就够了 —— 之后 nexusp2p.exe 不用再带 --signaling。
  //
  // 局域网对测：填 start-signaling.cmd 打出来的那个地址，例如
  //   "signaling": "http://192.168.1.10:5000"
  //
  // 跨公网：填你部署的域名，例如
  //   "signaling": "https://p2p.你的域名"
  "signaling": "",

  // 兜底的 ICE 服务器。**正常情况下留空**：信令服务器会在进房时
  // 下发带时限凭据的 TURN 地址，那份优先级更高。
  // 只有在服务端没配 TURN、又想手动指定时才需要填。
  "iceServers": []
}
